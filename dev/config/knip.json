{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "electron/preload.cjs",
    "src/**/*.test.ts",
    "electron/**/*.test.ts",
    "dev/test/e2e/**/*.spec.ts",
    "dev/test/e2e/**/*.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "electron/**/*.cjs",
    "electron/**/*.test.ts",
    "dev/test/e2e/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "vite": {
    "config": "dev/config/vite.config.mts"
  },
  "vitest": {
    "config": "dev/config/vitest.config.mts"
  },
  "playwright": {
    "config": "dev/config/playwright.config.ts"
  }
}
