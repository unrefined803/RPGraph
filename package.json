{
  "name": "rpgraph-studio",
  "private": true,
  "version": "0.7.3",
  "description": "Local-first node graph studio for roleplay workflows.",
  "author": {
    "name": "unrefined803",
    "url": "https://github.com/unrefined803"
  },
  "desktopName": "rpgraph-studio.desktop",
  "license": "AGPL-3.0-or-later",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config dev/config/vite.config.mts",
    "build": "tsc -b && vite build --config dev/config/vite.config.mts",
    "package:linux": "npm run build && electron-builder --config dev/config/electron-builder.yml --linux AppImage --x64 --publish never && npm run package:linux:verify",
    "package:linux:verify": "node scripts/verify-linux-package.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "package:windows:verify": "node scripts/verify-windows-package.mjs",
    "lint": "eslint .",
    "check:unused": "knip --config dev/config/knip.json",
    "test": "node scripts/run-tests.mjs vitest run --config dev/config/vitest.config.mts",
    "test:watch": "node scripts/run-tests.mjs vitest --watch --config dev/config/vitest.config.mts",
    "test:coverage": "node scripts/run-tests.mjs vitest run --coverage --config dev/config/vitest.config.mts",
    "test:e2e": "node scripts/run-tests.mjs playwright test --config dev/config/playwright.config.ts",
    "test:e2e:headed": "node scripts/run-tests.mjs playwright test --headed --config dev/config/playwright.config.ts",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "workflow:prompts:extract": "node scripts/workflow-prompts.mjs extract",
    "workflow:prompts:merge": "node scripts/workflow-prompts.mjs merge",
    "storybook:redact": "node scripts/storybook-media.mjs redact",
    "storybook:merge": "node scripts/storybook-media.mjs merge",
    "preview": "vite preview --config dev/config/vite.config.mts",
    "desktop:dev": "concurrently -k \"vite --config dev/config/vite.config.mts\" \"wait-on tcp:5173 && node scripts/run-electron.mjs --dev --no-sandbox\"",
    "desktop": "node scripts/run-electron.mjs --no-sandbox",
    "desktop:windows:dev": "concurrently -k \"vite --config dev/config/vite.config.mts\" \"wait-on tcp:5173 && node scripts/run-electron.mjs --dev\"",
    "desktop:windows": "node scripts/run-electron.mjs",
    "character:migrate-v3": "node scripts/migrate-character-v3.mjs",
    "character:create": "node scripts/create-character-container.mjs",
    "npc:report": "node scripts/report-npc-population.mjs",
    "character:inspect": "node scripts/inspect-character-container.mjs",
    "character:unpack": "node scripts/unpack-character-workspace.mjs",
    "character:pack": "node scripts/pack-character-workspace.mjs",
    "character:edit": "node scripts/edit-character-container.mjs",
    "character:convert-demos": "node scripts/convert-demo-characters.mjs",
    "character:faces:setup": "node scripts/setup-character-faces.mjs",
    "character:faces": "node scripts/backfill-character-faces.mjs",
    "perf:summary": "node scripts/ui-performance-summary.mjs"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "@xyflow/react": "^12.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "knip": "6.38.0",
    "rimraf": "file:dev/tools/temp-rimraf",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@electron/asar": "4.3.1",
    "temp@0.9.4": {
      "rimraf": "$rimraf"
    },
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
